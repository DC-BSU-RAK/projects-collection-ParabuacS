<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/codex_black">

    <!--The loading bar is circular and goes around the title-->
    <ProgressBar
        android:id="@+id/splashLoader"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/codex_dark_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Character\nCodex"
        android:textAlignment="center"
        android:textColor="@color/codex_white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/splashLoader"
        app:layout_constraintEnd_toEndOf="@id/splashLoader"
        app:layout_constraintStart_toStartOf="@id/splashLoader"
        app:layout_constraintTop_toTopOf="@id/splashLoader" />

</androidx.constraintlayout.widget.ConstraintLayout>