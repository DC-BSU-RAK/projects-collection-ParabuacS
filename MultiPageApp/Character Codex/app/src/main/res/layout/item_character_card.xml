<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_background"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:elevation="4dp">
    <!--This is a suggestion by Gemini to have a clickable character card-->
    <!--Character icon-->
    <ImageView
        android:id="@+id/imgCharacterSigil"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@color/codex_dark_green"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="@color/codex_white" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/txtCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Character Name"
            android:textColor="@color/codex_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif" />
        <TextView
            android:id="@+id/txtCardRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The Protagonist"
            android:textColor="@color/codex_gray"
            android:textSize="14sp"
            android:textStyle="italic" />

    </LinearLayout>
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_media_play"
        app:tint="@color/codex_accent_green" />

</LinearLayout>